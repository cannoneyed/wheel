{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wheel-chalk",
  "main": "cloudflare/chalk-worker.ts",
  "compatibility_date": "2026-08-21",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "packages/chalk/dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHALK_WORKSPACES",
        "class_name": "ChalkWorkspace"
      }
    ]
  },
  "exports": {
    "ChalkWorkspace": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
